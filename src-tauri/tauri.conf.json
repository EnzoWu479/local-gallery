{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Gallery",
  "version": "0.1.0",
  "identifier": "com.enzo-wu.local-gallery",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Local Gallery",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Enzo Wu",
    "copyright": "© 2026 Enzo Wu",
    "category": "Photography",
    "shortDescription": "Galeria local de imagens, áudios e vídeos a partir de links",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Local Gallery"
      }
    }
  }
}
